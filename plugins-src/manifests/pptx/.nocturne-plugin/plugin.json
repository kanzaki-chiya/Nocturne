{
  "name": "pptx",
  "version": "0.68.0",
  "description": "创建、读取、编辑、转换与按页预览演示文稿。",
  "skills": "./skills",
  "agents": "./agents",
  "mcpServers": {
    "slides": {
      "command": "${NOCTURNE_NODE}",
      "args": ["${PLUGIN_ROOT}/server.mjs"]
    }
  },
  "interface": {
    "displayName": "演示文档",
    "composerIcon": "./icon.svg"
  },
  "ui": {
    "surfaces": [
      {
        "id": "viewer",
        "title": "演示文档",
        "server": "slides",
        "resourceUri": "ui://slides/viewer.html",
        "open": {
          "tool": "show_in_viewer",
          "fileTypes": [".pptx", ".ppt", ".odp"]
        }
      }
    ]
  }
}
