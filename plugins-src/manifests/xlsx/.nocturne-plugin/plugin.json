{
  "name": "xlsx",
  "version": "0.62.0",
  "description": "创建、读取、编辑、重算、转换与按页预览电子表格。",
  "skills": "./skills",
  "agents": "./agents",
  "mcpServers": {
    "sheets": {
      "command": "${NOCTURNE_NODE}",
      "args": ["${PLUGIN_ROOT}/server.mjs"]
    }
  },
  "interface": {
    "displayName": "电子表格",
    "composerIcon": "./icon.svg"
  },
  "ui": {
    "surfaces": [
      {
        "id": "viewer",
        "title": "电子表格",
        "server": "sheets",
        "resourceUri": "ui://sheets/viewer.html",
        "open": {
          "tool": "show_in_viewer",
          "fileTypes": [".xlsx", ".xls", ".ods"]
        }
      }
    ]
  }
}
