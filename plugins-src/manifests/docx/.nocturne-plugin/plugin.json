{
  "name": "docx",
  "version": "0.59.0",
  "description": "创建、读取、编辑、转换与按页预览 Word 文档。",
  "skills": "./skills",
  "agents": "./agents",
  "mcpServers": {
    "word": {
      "command": "${NOCTURNE_NODE}",
      "args": ["${PLUGIN_ROOT}/server.mjs"]
    }
  },
  "interface": {
    "displayName": "Word 文档",
    "composerIcon": "./icon.svg"
  },
  "ui": {
    "surfaces": [
      {
        "id": "viewer",
        "title": "Word 文档",
        "server": "word",
        "resourceUri": "ui://word/viewer.html",
        "open": {
          "tool": "show_in_viewer",
          "fileTypes": [".docx", ".doc", ".odt", ".rtf"]
        }
      }
    ]
  }
}
