{
  "name": "pdf",
  "version": "0.59.0",
  "description": "生成、提取文本、按页预览、合并与拆分 PDF 文档。",
  "skills": "./skills",
  "agents": "./agents",
  "mcpServers": {
    "pdf": {
      "command": "${NOCTURNE_NODE}",
      "args": ["${PLUGIN_ROOT}/server.mjs"]
    }
  },
  "interface": {
    "displayName": "PDF",
    "composerIcon": "./icon.svg"
  },
  "ui": {
    "surfaces": [
      {
        "id": "viewer",
        "title": "PDF",
        "server": "pdf",
        "resourceUri": "ui://pdf/viewer.html",
        "open": {
          "tool": "show_in_viewer",
          "fileTypes": [".pdf"]
        }
      }
    ]
  }
}
