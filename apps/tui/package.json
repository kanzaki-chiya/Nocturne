{
  "name": "@nocturne/tui",
  "version": "0.7.6",
  "description": "Nocturne terminal UI client (Ink + React)，由 nctrn --tui 惰性加载",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./provider-login": {
      "types": "./dist/provider-login.d.mts",
      "import": "./dist/provider-login.mjs"
    },
    "./provider-setup-flow": {
      "types": "./dist/provider-setup-flow.d.mts",
      "import": "./dist/provider-setup-flow.mjs"
    },
    "./provider-prompts": {
      "types": "./dist/provider-prompts.d.mts",
      "import": "./dist/provider-prompts.mjs"
    },
    "./text-format": {
      "types": "./dist/text-format.d.mts",
      "import": "./dist/text-format.mjs"
    },
    "./slash-catalog": {
      "types": "./dist/slash-catalog.d.mts",
      "import": "./dist/slash-catalog.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nocturne/core": "workspace:*",
    "ink": "7.1.1",
    "marked": "18.0.7",
    "react": "19.3.0",
    "string-width": "8.2.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0"
  }
}
