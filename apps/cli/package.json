{
  "name": "@nocturne/cli",
  "version": "0.8.0",
  "description": "nctrn — Nocturne CLI client",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "bin": {
    "nctrn": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@nocturne/acp": "workspace:*",
    "@nocturne/core": "workspace:*",
    "@nocturne/mcp": "workspace:*",
    "@nocturne/rpc": "workspace:*",
    "@nocturne/tui": "workspace:*"
  }
}
