# systemd: 复制到 /etc/nocturne-relay.env，权限设为 root:root 0600。
# 域名必须是小写的 HTTPS origin，无尾斜杠；与反向代理域名一致。
NOCTURNE_RELAY_PUBLIC_ORIGIN=https://relay.example.com
NOCTURNE_RELAY_TRUST_PROXY=true
# systemd unit / Docker 镜像已设置监听与数据目录；手动运行时可指定：
# NOCTURNE_RELAY_LISTEN=127.0.0.1:8787
# NOCTURNE_RELAY_DATA_DIR=/var/lib/nocturne-relay
# VAPID 首次启动自动生成；可选联系方式（默认使用 PUBLIC_ORIGIN）：
# NOCTURNE_RELAY_VAPID_SUBJECT=mailto:admin@example.com
# 限额按需覆盖，未列出的值保持默认：
# NOCTURNE_RELAY_LIMITS={"devices":5,"connections":10,"ratePerMinute":10}
