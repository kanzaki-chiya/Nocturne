{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主窗口：四个后台命令、文件夹选择、受限外链",
  "windows": ["main"],
  "permissions": [
    "allow-backend-open",
    "allow-backend-send",
    "allow-backend-close",
    "allow-node-probe",
    "allow-plain-workspace",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "http://localhost:*" },
        { "url": "http://localhost:*/*" }
      ]
    }
  ]
}
