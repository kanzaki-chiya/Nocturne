{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "主界面 webview：外壳命令、面板终端与浏览器、文件夹与图片选择、受限外链、自动更新。只按 webview 标签匹配，面板浏览器的 webview 不匹配（ADR-0060 修订（四））",
  "webviews": ["main"],
  "permissions": [
    "allow-app-note",
    "allow-backend-open",
    "allow-backend-send",
    "allow-backend-close",
    "allow-backend-stderr",
    "allow-node-probe",
    "allow-plain-workspace",
    "allow-shell-log",
    "allow-pick-images",
    "allow-open-skill-directory",
    "core:app:allow-version",
    "core:path:allow-resolve-directory",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "dialog:allow-open",
    "process:allow-restart",
    "updater:allow-check",
    "updater:allow-download-and-install",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://localhost:*/*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "allow-detect-editors",
    "allow-open-in-editor",
    "allow-open-with-default",
    "allow-notify-show",
    "allow-notify-dismiss",
    "allow-terminal-open",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close",
    "allow-terminal-read-clipboard",
    "allow-terminal-write-clipboard",
    "allow-browser-create",
    "allow-browser-navigate",
    "allow-browser-layout",
    "allow-browser-action",
    "allow-browser-capture",
    "allow-browser-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-request-user-attention"
  ]
}
