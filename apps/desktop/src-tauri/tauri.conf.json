{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nocturne",
  "version": "0.7.0",
  "identifier": "io.github.kanzaki-chiya.nocturne",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm vite build",
    "devUrl": "http://localhost:31420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nocturne",
        "width": 1200,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:31420 http://localhost:31420; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/nctrn.mjs": "nctrn.mjs",
      "resources/node/node.exe": "node/node.exe",
      "resources/node/LICENSE": "node/LICENSE"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RTU5NDQ0QUNDRDEzRDgKUldUWUU4MnNSSlRsVmVKTkdLSVQ2ZHF2V1ZmQ21qWHpja242SkpReHUwZjJWRWM1Y25lM3V6RlQK",
      "endpoints": [
        "https://github.com/kanzaki-chiya/Nocturne/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
