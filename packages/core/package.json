{
  "name": "@nocturne/core",
  "version": "0.6.0",
  "description": "Nocturne runtime: sessions, agent loop, context, tools, permissions, providers",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.mts",
      "import": "./dist/protocol/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@ai-sdk/openai": "4.0.72",
    "@ai-sdk/openai-compatible": "3.0.49",
    "ai": "7.0.102",
    "ajv": "8.20.0",
    "node-html-markdown": "2.0.0",
    "string-width": "8.2.2",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  }
}
