{
  "name": "@nocturne/open-artifact",
  "version": "0.68.0",
  "description": "Nocturne Open Artifact 集成连接器与工具包装（ADR-0125）",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nocturne/core": "workspace:*",
    "@open-artifact/cli": "0.16.3",
    "@open-artifact/harness-kit": "0.16.3",
    "@open-artifact/protocol": "0.16.3"
  }
}
