{
  "name": "@nocturne/acp",
  "version": "0.8.2",
  "description": "Nocturne ACP external agent connector（ADR-0049）",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@nocturne/core": "workspace:*",
    "zod": "4.6.5"
  }
}
