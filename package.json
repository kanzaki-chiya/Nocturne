{
  "name": "nocturne",
  "private": true,
  "version": "0.5.0",
  "description": "Nocturne — open-source coding agent runtime",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:smoke": "pnpm build && pnpm -r test:smoke",
    "depcheck": "dependency-cruiser packages apps --config .dependency-cruiser.cjs",
    "desktop:dev": "pnpm --filter @nocturne/desktop dev"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
