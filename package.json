{
  "name": "nocturne",
  "private": true,
  "version": "0.7.3",
  "description": "Nocturne — open-source coding agent runtime",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test && vitest run --root scripts",
    "test:smoke": "pnpm build && pnpm -r test:smoke",
    "depcheck": "dependency-cruiser packages apps --config .dependency-cruiser.cjs",
    "desktop:dev": "node scripts/fetch-node.mjs && pnpm --filter @nocturne/desktop dev",
    "desktop:build": "pnpm build && node scripts/bundle-nctrn.mjs && node scripts/fetch-node.mjs && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml && pnpm --dir apps/desktop exec tauri build",
    "release:build": "node scripts/release-build.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
